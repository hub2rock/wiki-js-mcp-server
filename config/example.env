# wiki-js-mcp-server — Configuration
# Copy this file to .env at the project root and fill in your values.
# Never commit .env to version control.

# ── Wiki.js ───────────────────────────────────────────────────────────────────
WIKIJS_URL=https://your-wiki.example.com
# Shared key — used only when MCP_AUTH_MODE=none. In oauth mode leave it empty:
# each user registers their own key with the wikijs_register_my_key tool.
WIKIJS_API_KEY=your_api_key_here
WIKIJS_GRAPHQL_ENDPOINT=/graphql

# ── Transport ─────────────────────────────────────────────────────────────────
# stdio  → Claude Desktop local (process spawned directly)
# http   → Docker remote (server listens on HTTP/SSE)
MCP_TRANSPORT=stdio

# HTTP mode (only used when MCP_TRANSPORT=http)
HTTP_HOST=0.0.0.0
HTTP_PORT=8000

# ── Auth ──────────────────────────────────────────────────────────────────────
# none  → one shared WIKIJS_API_KEY (stdio / personal use)
# oauth → multi-user connector. Callers authenticate via OAuth 2.1 and each one
#         registers their own Wiki.js key, so Wiki.js enforces per-user rights.
MCP_AUTH_MODE=none

# --- The rest of this block is only read when MCP_AUTH_MODE=oauth ---

# Public HTTPS base URL of THIS server (no trailing slash). Claude connects from
# Anthropic's cloud, so it must be reachable from the public internet.
MCP_PUBLIC_URL=https://mcp-wiki.example.com

# OAuth issuer. For Authentik this is the application's OIDC issuer URL.
OAUTH_ISSUER=https://auth.example.com/application/o/wikijs-mcp/
# JWKS is discovered from the issuer's OIDC config; set only to override.
OAUTH_JWKS_URL=
# Expected `aud` claim (usually the Authentik client ID). Empty = no aud check.
OAUTH_AUDIENCE=
OAUTH_ALGORITHMS=RS256
# Scopes a token must carry to be accepted. Empty = no scope check.
OAUTH_REQUIRED_SCOPES=
OAUTH_SUPPORTED_SCOPES=openid profile email

# Encrypts each user's stored Wiki.js key at rest. Strongly recommended.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MCP_ENCRYPTION_KEY=

# ── Storage ───────────────────────────────────────────────────────────────────
# ⚠️  Use absolute paths in stdio mode — Claude Desktop launches from /
# Example: /Users/yourname/tools/wiki-js-mcp-server/wikijs_mappings.db
WIKIJS_MCP_DB=./wikijs_mappings.db
LOG_FILE=./wikijs_mcp.log

# ── Content ───────────────────────────────────────────────────────────────────
# Default locale for created/read pages. Leave empty to auto-detect the
# Wiki.js instance's own default locale (e.g. 'fr'). Set explicitly (e.g. 'en')
# to force a locale regardless of the instance default.
WIKIJS_DEFAULT_LOCALE=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
DEFAULT_SPACE_NAME=Documentation
